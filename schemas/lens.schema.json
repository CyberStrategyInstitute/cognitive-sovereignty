{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberstrategyinstitute.github.io/cognitive-sovereignty/schemas/lens-v1",
  "title": "Declared CSF lens profile v1",
  "type": "object",
  "required": [
    "id",
    "version",
    "type",
    "owner",
    "baseline_id",
    "method",
    "sources",
    "assumptions",
    "questions",
    "restrictions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "baseline",
        "nation-state",
        "political",
        "ideological",
        "religious"
      ]
    },
    "owner": {
      "type": "string"
    },
    "baseline_id": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "const": "CTSS-existing-v1"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "restrictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "weights"
        ]
      },
      {
        "required": [
          "formula"
        ]
      }
    ]
  }
}
