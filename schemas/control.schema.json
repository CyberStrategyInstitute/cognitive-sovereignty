{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CSF mitigation record",
  "type": "object",
  "required": [
    "id",
    "domain_id",
    "name",
    "kind",
    "taxonomy",
    "implementation",
    "owner_role",
    "expected_outcome",
    "test",
    "failure_response",
    "research_notes",
    "evidence_status",
    "readiness_profile",
    "rationale"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "implementation": {
      "type": "string",
      "minLength": 1
    },
    "owner_role": {
      "type": "string",
      "minLength": 1
    },
    "expected_outcome": {
      "type": "string",
      "minLength": 1
    },
    "test": {
      "type": "string",
      "minLength": 1
    },
    "failure_response": {
      "type": "string",
      "minLength": 1
    },
    "evidence_status": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^M-[A-Za-z0-9]+$"
    },
    "domain_id": {
      "enum": [
        "D1",
        "D2",
        "D3",
        "D4",
        "D5",
        "D6"
      ]
    },
    "kind": {
      "enum": [
        "inherited",
        "refined",
        "added"
      ]
    },
    "taxonomy": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "research_notes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "readiness_profile": {
      "enum": [
        "legacy-v1",
        "research-extension-v1"
      ]
    }
  }
}
